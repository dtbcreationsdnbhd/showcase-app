# Same Supabase project as apps/web (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# staging_inquiries locally and on Vercel Preview; production_inquiries on Vercel Production
NEXT_PUBLIC_INQUIRY_TABLE=staging_inquiries
# staging_projects locally and on Vercel Preview; production_projects on Vercel Production
NEXT_PUBLIC_PROJECT_TABLE=staging_projects
